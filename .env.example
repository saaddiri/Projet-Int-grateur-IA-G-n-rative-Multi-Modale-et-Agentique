# --- PostgreSQL / PGVector (voir docker-compose.yml) ---
PG_HOST=localhost
PG_PORT=5433
PG_USER=maintidoc
PG_PASSWORD=maintidoc
PG_DATABASE=maintidoc

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
# LLM utilisé pour la génération et l'agent (doit supporter le "tool calling")
LLM_MODEL=qwen2.5:3b
# Modèle vision-langage utilisé pour décrire les images extraites du PDF
VLM_MODEL=qwen2.5vl:3b

# --- Modèles d'embeddings (Hugging Face, open source) ---
# Embeddings texte multilingues (questions en français sur un document en anglais).
# Alternative plus précise mais plus lourde (2,2 Go) : BAAI/bge-m3
TEXT_EMBED_MODEL=intfloat/multilingual-e5-small
# Encodeur CLIP pour la recherche texte -> image
CLIP_MODEL=openai/clip-vit-base-patch32

# --- Découpage ---
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Mettre à 0 pour indexer les images sans description VLM (plus rapide sur CPU)
DESCRIBE_IMAGES=1

# --- Étape 2 : multimodalité et reranking ---
# Encodeur de texte multilingue aligné sur CLIP ViT-B/32 (recherche texte -> image en français)
MCLIP_TEXT_MODEL=sentence-transformers/clip-ViT-B-32-multilingual-v1
# Reranker : vide = adapté (models/reranker-maintidoc-v1) s'il existe, sinon initial ;
# ou "none", "base", "adapted", ou un chemin / identifiant de modèle
RERANKER=
