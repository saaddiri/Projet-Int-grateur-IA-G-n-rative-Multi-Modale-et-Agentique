# --- PostgreSQL / PGVector (voir docker-compose.yml) ---
PG_HOST=localhost
PG_PORT=5433
PG_USER=maintidoc
PG_PASSWORD=maintidoc
PG_DATABASE=maintidoc

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
# LLM utilisé pour la génération et l'agent (doit supporter le "tool calling")
LLM_MODEL=qwen2.5:3b
# Modèle vision-langage utilisé pour décrire les images extraites du PDF
VLM_MODEL=qwen2.5vl:3b

# --- Modèles d'embeddings (Hugging Face, open source) ---
# Embeddings texte multilingues (questions en français sur un document en anglais).
# Alternative plus précise mais plus lourde (2,2 Go) : BAAI/bge-m3
TEXT_EMBED_MODEL=intfloat/multilingual-e5-small
# Encodeur CLIP pour la recherche texte -> image
CLIP_MODEL=openai/clip-vit-base-patch32

# --- Découpage ---
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Mettre à 0 pour indexer les images sans description VLM (plus rapide sur CPU)
DESCRIBE_IMAGES=1

# --- Étape 2 : multimodalité et reranking ---
# Encodeur de texte multilingue aligné sur CLIP ViT-B/32 (recherche texte -> image en français)
MCLIP_TEXT_MODEL=sentence-transformers/clip-ViT-B-32-multilingual-v1
# Reranker : vide = adapté (models/reranker-maintidoc-v1) s'il existe, sinon initial ;
# ou "none", "base", "adapted", ou un chemin / identifiant de modèle
RERANKER=

# --- Étape 3 : orchestration LangGraph et serveur MCP de maintenance ---
# Secret HMAC des jetons d'approbation (partagé application / serveur MCP) : À CHANGER
APPROVAL_SECRET=dev-only-change-me
# Clé API de l'utilisateur courant (comptes de démonstration : demo-key-dupont,
# demo-key-martin, demo-key-leroy ; voir data/maintenance/seed.json)
MAINTIDOC_API_KEY=demo-key-dupont
# Base SQLite du service de maintenance simulé (créée et remplie au premier lancement)
# MAINTENANCE_DB=storage/maintenance.db

# --- Étape 4 : backend FastAPI, bot Telegram, déploiement ---
# Clé de service du backend auprès du serveur MCP (délégation d'identité) : À GÉNÉRER
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_SERVICE_KEY=
# Secret partagé bot -> backend (même valeur pour les deux services) : À GÉNÉRER
BOT_SHARED_SECRET=
# Jeton du bot créé avec @BotFather (ne jamais le versionner)
TELEGRAM_BOT_TOKEN=
# Adresse du backend vue par le bot (en Docker Compose : http://api:8000, déjà défini)
MAINTIDOC_API_URL=http://localhost:8000
# Limites d'appels par utilisateur et par minute (toutes requêtes / requêtes LLM)
RATE_LIMIT_PER_MINUTE=20
LLM_RATE_LIMIT_PER_MINUTE=4
# Ollama vu depuis les conteneurs (Ollama de l'hôte par défaut ; http://ollama:11434 avec --profile ollama)
OLLAMA_BASE_URL_DOCKER=http://host.docker.internal:11434
